{
 "cleanUrls": true,
 "trailingSlash": false,
 "headers": [
  {
   "source": "/assets/cdn.prod.website-files.com/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  },
  {
   "source": "/assets/unpkg.com/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  },
  {
   "source": "/fonts/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  },
  {
   "source": "/assets/(hover|intro|thumbs|eye)/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=86400, stale-while-revalidate=604800"
    }
   ]
  },
  {
   "source": "/assets/popsy-logo-v2.svg",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=86400, stale-while-revalidate=604800"
    }
   ]
  },
  {
   "source": "/images/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=86400, stale-while-revalidate=604800"
    }
   ]
  },
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    }
   ]
  }
 ]
}